{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "رفيق الصحة",
  "version": "2.0.0",
  "identifier": "com.family.healthtracker",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "رفيق الصحة — تتبع الجرعات والأدوية",
        "width": 1100,
        "height": 760,
        "minWidth": 420,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": ["icons/icon.ico", "icons/icon.icns", "icons/icon.png"]
  }
}
