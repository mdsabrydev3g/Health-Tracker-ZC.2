{
  "name": "health-tracker",
  "version": "2.0.0",
  "private": true,
  "description": "Health Tracker — رفيق الجرعات والصحة للعائلة (سطح مكتب + موبايل + أونلاين متزامن)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:api": "node scripts/build-api.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc -p server/api-src/tsconfig.json --noEmit",
    "cap:add": "cap add android",
    "cap:sync": "vite build && cap sync android",
    "cap:open": "cap open android",
    "icons": "npx @capacitor/assets generate"
  },
  "dependencies": {
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/local-notifications": "^6.1.0",
    "@capacitor/preferences": "^6.0.2",
    "@neondatabase/serverless": "^0.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "dexie": "^4.0.8",
    "dexie-react-hooks": "^1.1.7",
    "html5-qrcode": "^2.3.8",
    "jose": "^5.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
